{
  "name": "ai-ecommerce-assistant",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "backend:install": "cd backend && pip install -r requirements.txt",
    "backend:dev": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev -- --host 0.0.0.0",
    "docker:up": "docker compose up --build"
  }
}
